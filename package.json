{
  "name": "@chenjazzyboss/superspec",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-native spec management tool for Claude Code",
  "main": "./dist/index.js",
  "bin": {
    "superspec": "./bin/superspec.js"
  },
  "scripts": {
    "build": "node build.js",
    "typecheck": "tsc --noEmit",
    "bundle-validate": "node scripts/bundle-validate.js",
    "test": "vitest run",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build && npm run bundle-validate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "commander": "^12.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "spec",
    "claude-code",
    "specification"
  ]
}
